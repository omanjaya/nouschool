# === DEV ===
# Jalankan: caddy run  (butuh Caddy terinstall; opsional saat dev — Vite proxy juga bisa)
localhost {
	handle /api/* {
		reverse_proxy localhost:8080
	}
	handle {
		reverse_proxy localhost:5173
	}
}

