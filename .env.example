# Salin ke .env (jangan commit .env). Semua secret hanya lewat env.
APP_ENV=dev
# Catatan: di mesin dev Windows ini, range 7929-8171 direserve Hyper-V (8080 tidak bisa).
PORT=8210
# Format: postgres://user:password@localhost:5432/nouschool?sslmode=disable
DATABASE_URL=
# Domain utama platform (prod: nouschool.id)
BASE_DOMAIN=localhost
