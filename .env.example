# Salin ke .env (jangan commit .env). Semua secret hanya lewat env.
APP_ENV=dev
# Catatan: di mesin dev Windows ini, range 7929-8171 direserve Hyper-V (8080 tidak bisa).
PORT=8210
# Format: postgres://user:password@localhost:5432/nouschool?sslmode=disable
DATABASE_URL=
# Domain utama platform (prod: nouschool.id)
BASE_DOMAIN=localhost

# -- Notification (Fase 9, lihat docs/08-notification.md) --
# Kosong = channel dianggap TIDAK dikonfigurasi (outbox row tidak dibuat).
# VAPID web push: kosong = di-generate otomatis saat startup & disimpan ke
# tabel platform_config supaya stabil antar-restart (lihat internal/notification/webpush.go).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBSCRIBER=mailto:admin@nouschool.id
# WhatsApp: HTTP gateway generik gaya Fonnte (POST target+message).
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
# Email: SMTP polos (net/smtp), plain text.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nouschool.id
